# Copy to .env.local and fill in. Never commit real keys.

# Claude (optional for local dev: without it the app uses a rule-based analysis)
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5. claude-haiku-5-5 is far cheaper.
# ANTHROPIC_MODEL=claude-opus-5-5

# Supabase (optional for local dev: without it reports live in memory)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay TEST MODE keys (Dashboard → Settings → API Keys, test mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
